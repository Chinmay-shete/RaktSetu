# RaktSetu Environment Variables Example
# Duplicate this file as '.env' or '.env.local' in your React project root directory to configure the application.

# ─────────────────────────────────────────────────────────────────────────────
# 1. HOSPITAL ADMIN CREDENTIALS (Vite Env Variables)
# ─────────────────────────────────────────────────────────────────────────────
VITE_ADMIN_EMAIL=admin@raktsetu.org
VITE_ADMIN_PASSWORD=admin123

# ─────────────────────────────────────────────────────────────────────────────
# 2. OTHER NON-DONOR WORKING DEMO CREDENTIALS (For Reference / Local Testing)
# ─────────────────────────────────────────────────────────────────────────────

# --- HOSPITAL STAFF ---
# Role checks for email domain containing 'staff' or matches hospital default contact.
# Any password is authenticated if it matches 'admin123' (fallback).
# Email: staff@hospital.com (or contact@citylifehospital.org)
# Password: admin123

# --- DISTRICT OFFICER ---
# Email: officer@pune.gov.in
# Password: district123

# --- STATE ADMIN ---
# Email: admin@health.maharashtra.gov.in
# Password: state2026

# --- SYSTEM ADMIN ---
# Email: admin@raktsetu.com
# Password: system123

# ─────────────────────────────────────────────────────────────────────────────
# 3. PRODUCTION & API CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Set this to your deployed backend URL in production (e.g. https://api.raktsetu.org/api/v1)
VITE_API_URL=http://localhost:5000/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# 4. FIREBASE CONFIGURATION (For Donor OTP SMS Authentication)
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
