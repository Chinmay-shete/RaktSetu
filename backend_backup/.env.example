# RaktSetu Backend — copy to .env and adjust values

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=5000

# JWT / OTP
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=7
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=raktsetu
DB_PASSWORD=raktsetu_secret
DB_NAME=raktsetu
DB_POOL_SIZE=10
DB_POOL_NAME=raktsetu_pool

# AI forecast microservice (optional — baseline used if unreachable)
AI_SERVICE_URL=http://127.0.0.1:5001
AI_SERVICE_TIMEOUT=10

# Redis cache for forecast (optional — in-memory fallback if unset)
REDIS_URL=
