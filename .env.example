# ─────────────────────────────────────────────────────────────────────────────
# RaktSetu — Fullstack Environment Configurations
# ─────────────────────────────────────────────────────────────────────────────
# Duplicate this file as '.env' in both 'backend/' and 'frontend/' directories
# and customize the values for your local environment.

# =============================================================================
# 🖥️ BACKEND CONFIGURATIONS (Place in backend/.env)
# =============================================================================

# Server Port
PORT=5000

# Database Configuration (MySQL v8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=raktsetu

# JWT Authentication Secrets (Generate secure strings, min 32 chars)
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_must_be_at_least_32_chars
JWT_OTP_SECRET=your_jwt_otp_secret_key_here_must_be_at_least_32_chars

# Node Environment
NODE_ENV=development

# CORS Policy Origins
CORS_ORIGIN=http://localhost:5173

# AI Python Service URL
AI_SERVICE_URL=http://localhost:5001

# MSG91 SMS Credentials (India-ready 🇮🇳)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here
MSG91_SENDER_ID=RAKSETU

# Resend Email Integration (For staff invites and notifications)
EMAIL_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=onboarding@resend.dev


# =============================================================================
# 💻 FRONTEND CONFIGURATIONS (Place in frontend/.env)
# =============================================================================

# API Endpoint URL
VITE_API_URL=http://localhost:5000/v1
VITE_API_BASE_URL=http://localhost:5000/v1

# Hospital Admin Default Credentials (For demo login)
VITE_ADMIN_EMAIL=admin@raktsetu.org
VITE_ADMIN_PASSWORD=admin123
