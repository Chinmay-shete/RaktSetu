PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=raktsetu
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_must_be_at_least_32_chars
JWT_OTP_SECRET=your_jwt_otp_secret_key_here_must_be_at_least_32_chars
CORS_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:5001
NODE_ENV=development

# Twilio Credentials (Get from twilio.com Console -> Account SID and Auth Token)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Resend Transactional Email API Key (Get from resend.com)
EMAIL_API_KEY=re_your_resend_api_key_here

# Resend Authorized Sending Address (Use onboarding@resend.dev for testing without verified domain)
EMAIL_FROM_ADDRESS=onboarding@resend.dev
