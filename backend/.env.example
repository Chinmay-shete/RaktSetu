# Server
PORT=5000
NODE_ENV=production

# Database — Primary (Write)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-strong-password
DB_NAME=raktsetu
DB_POOL_SIZE=50

# Database — Read Replica (Can be same as primary initially)
DB_READ_HOST=127.0.0.1
DB_READ_POOL_SIZE=100

# Redis Cache & Task Broker
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Auth Secrets
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_must_be_at_least_32_chars
JWT_OTP_SECRET=your_jwt_otp_secret_key_here_must_be_at_least_32_chars
CORS_ORIGIN=https://raktsetu.com

# Microservices Links
AI_SERVICE_URL=http://localhost:5001
INTERNAL_API_SECRET=super_secret_internal_token_2026

# Twilio Credentials (Get from twilio.com Console -> Account SID and Auth Token)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Resend Transactional Email API Key (Get from resend.com)
EMAIL_API_KEY=re_your_resend_api_key_here

# Resend Authorized Sending Address (Use onboarding@resend.dev for testing without verified domain)
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Firebase Admin SDK Service Account JSON path (Optional, used for phone OTP verification)
# Make sure to create this file under backend/secrets/ (which is ignored by git)
FIREBASE_SA_PATH=secrets/firebase-service-account.json

