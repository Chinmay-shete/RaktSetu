{
  "name": "raktsetu-backend",
  "version": "1.0.0",
  "description": "RaktSetu core Node.js backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "migrate": "node -r dotenv/config -e \"const { execSync } = require('child_process'); const env = { ...process.env }; if (process.env.DB_PASSWORD) env.MYSQL_PWD = process.env.DB_PASSWORD; execSync('mysql -u ' + (process.env.DB_USER || process.env.DB_USERNAME || 'root') + ' -h ' + (process.env.DB_HOST || '127.0.0.1') + ' ' + (process.env.DB_NAME || process.env.DB_DATABASE || 'raktsetu') + ' < ./models/migrations/001_initial_schema.sql', { env, stdio: 'inherit' });\""
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^10.3.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.9.7",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.16.0",
    "twilio": "^6.0.2",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jose)/)"
    ],
    "moduleNameMapper": {
      "^firebase-admin$": "<rootDir>/tests/mocks/firebaseAdminMock.js",
      "^firebase-admin/auth$": "<rootDir>/tests/mocks/firebaseAdminMock.js"
    }
  },
  "private": true
}
